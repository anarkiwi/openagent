# Ollama server, shared by every opencode session on a host. run.sh runs it as
# the owner of its models under the shared scratch mount; umask 002 keeps what
# it writes there group-writable wherever Ollama does not fix the mode itself.
FROM ollama/ollama:0.40.4
ENTRYPOINT ["/bin/sh", "-c", "umask 002 && exec /bin/ollama serve"]
